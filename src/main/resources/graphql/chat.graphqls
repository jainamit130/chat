type ChatRoom {
    id: String!
    chatRoomName: String!
    userIds: [String!]!
    chatRoomType: ChatRoomType!
    unreadMessageCount: Int!
    latestMessage: ChatMessage!
}

type ChatMessage {
    id: String!
    senderId: String!
}

enum MessageStatus {
    DELIVERED
    READ
    PENDING
    FAILED
}

enum ChatRoomType {
    DIRECT
    GROUP
    SELF
}

type User {
    id: String!
    username: String!
}

type Query {
    getChatRoomsOfUser: [ChatRoom!]!
}

