type ChatRoom {
    id: String!
    chatRoomName: String!
    userIds: [String!]!
    chatRoomType: ChatRoomType!
    unreadMessageCount: Int!
    latestMessage: latestMessage!
}

type latestMessage {
    id: String
    senderId: String
    status: MessageStatus
    content: String!
    timestamp: String
    name: String
}

type ChatMessage {
    id: String!
    senderId: String!
    deletedForEveryone: Boolean!
    name: String
    content: String!
    timestamp: String!
    status: MessageStatus
}

enum MessageStatus {
    DELIVERED
    READ
    PENDING
    FAILED
}

enum ChatRoomType {
    DIRECT
    GROUP
    SELF
}

type User {
    id: String!
    username: String!
}

interface IOnlineUsersDTO {
    lastSeenTimestamp: String
}

type DirectChatOnlineUsersDTO implements IOnlineUsersDTO {
    lastSeenTimestamp: String
}

type SelfChatOnlineUsersDTO implements IOnlineUsersDTO {
    lastSeenTimestamp: String
}

type GroupChatOnlineUsersDTO implements IOnlineUsersDTO {
    onlineUsers: [String]!
    lastSeenTimestamp: String
}

type ChatRoomData {
    messages: [ChatMessage]
    onlineUsersDTO: IOnlineUsersDTO
}

type Query {
    getChatRoomsOfUser: [ChatRoom!]!
    getChatRoomData(chatRoomId: String!): ChatRoomData!
}

