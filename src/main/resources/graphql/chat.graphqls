type ChatRoom {
    id: String!
    chatRoomName: String!
    userIds: [String!]!
    chatRoomType: ChatRoomType!
    unreadMessageCount: Int!
    latestMessage: latestMessage!
}

type latestMessage {
    content: String!
}

type ChatMessage {
    id: String!
    senderId: String!
    content: String!
    timestamp: String!
    status: MessageStatus!
}

enum MessageStatus {
    DELIVERED
    READ
    PENDING
    FAILED
}

enum ChatRoomType {
    DIRECT
    GROUP
    SELF
}

type User {
    id: String!
    username: String!
}

interface IOnlineUsersDTO {
}

type DirectChatOnlineUsersDTO implements IOnlineUsersDTO {
    lastSeenTimestamp: String
}

type GroupChatOnlineUsersDTO implements IOnlineUsersDTO {
    onlineUsers: [String]
}

type ChatRoomData {
    messages: [ChatMessage]
    onlineUsersDTO: IOnlineUsersDTO
}

type Query {
    getChatRoomsOfUser: [ChatRoom!]!
    getChatRoomData: [ChatMessage!]!
}

